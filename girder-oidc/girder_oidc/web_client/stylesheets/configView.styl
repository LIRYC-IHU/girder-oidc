.g-oidc-config-form
  max-width 640px

.g-oidc-redirect-uri-container
  margin 12px 0
  padding 6px 10px
  border 1px solid #ddd
  background-color #f6f6f6

  .g-oidc-redirect-uri
    margin-left 10px
    font-family monospace

.g-oidc-field-help
  margin 4px 0 0
  color #777
  font-size 12px

.g-oidc-actions
  display flex
  align-items center
  gap 10px

  .g-oidc-test
    margin-left 4px

.g-oidc-test-result
  margin-top 10px
  font-size 13px

  &.g-oidc-test-ok
    color #3c763d

  &.g-oidc-test-fail
    color #a94442

  code
    font-family monospace
